{
  "expo": {
    "name": "Adivinhe Futebol",
    "slug": "adivinhe-futebol",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "br.com.minanoideias.adivinhefutebol",
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "package": "br.com.minanoideias.adivinhefutebol",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#146c43"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#f3f6ef",
      "lang": "pt-BR"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#146c43",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 280
        }
      ],
      "expo-status-bar"
    ]
  }
}
